# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=urlshortener

# RabbitMQ - a dedicated user, not "guest": RabbitMQ restricts "guest" to
# loopback connections only, which container-to-container traffic never is.
RABBITMQ_USER=urlshortener
RABBITMQ_PASSWORD=urlshortener

# API Gateway - the only public HTTP entrypoint
HTTP_ADDR=:8080
BASE_URL=http://localhost:8080

# Core Service - internal, gRPC-only (not reachable directly by end users)
GRPC_ADDR=:9090
CACHE_TTL_SECONDS=300

# Stat Service - internal, gRPC-only. Its own listen port (:9091) is fixed
# in docker-compose.yml, not read from here (it's container topology, not a
# user-tunable setting) - see docker-compose.yml's statservice block.
CLICK_QUEUE=link.clicks
WORKER_COUNT=4
BATCH_SIZE=50
FLUSH_INTERVAL_MS=500

DEBUG=false

# Used by services running INSIDE the docker compose network
# (coreservice, statservice, the containerized migrate command) - host
# "postgres" resolves via Docker's internal DNS to the postgres service.
DATABASE_URL=postgres://postgres:postgres@postgres:5432/urlshortener?sslmode=disable

# Used by tooling running on the HOST (go test, an IDE debugger) -
# same database, but reached through the published port on localhost.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/urlshortener?sslmode=disable

# Used by services running INSIDE the docker compose network (gateway
# publishes, statservice consumes) - host "rabbitmq" resolves via Docker's
# internal DNS.
RABBITMQ_URL=amqp://urlshortener:urlshortener@rabbitmq:5672/
