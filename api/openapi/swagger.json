{
    "swagger": "2.0",
    "info": {
        "description": "Public REST API for the URL Shortener project. This is the only public HTTP surface in the system — Core Service and Stat Service are internal, gRPC-only, and reached through this Gateway.",
        "title": "URL Shortener API",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/",
    "paths": {
        "/health": {
            "get": {
                "description": "Liveness only — deliberately does not check Core/Stat Service reachability, so a downstream outage doesn't cause Gateway itself to be marked unhealthy and restarted.",
                "tags": [
                    "health"
                ],
                "summary": "Health check",
                "responses": {
                    "200": {
                        "description": "OK"
                    }
                }
            }
        },
        "/links": {
            "post": {
                "description": "Validates the URL and returns a newly created short code.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "links"
                ],
                "summary": "Create a short link",
                "parameters": [
                    {
                        "description": "URL to shorten",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/internal_gateway_transport_http.createLinkRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/internal_gateway_transport_http.linkResponse"
                        }
                    },
                    "400": {
                        "description": "invalid request body or URL",
                        "schema": {
                            "$ref": "#/definitions/internal_gateway_transport_http.errorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/internal_gateway_transport_http.errorResponse"
                        }
                    }
                }
            }
        },
        "/links/{code}": {
            "get": {
                "description": "Returns the short code, long URL and creation time — does not redirect.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "links"
                ],
                "summary": "Get link info",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Short code",
                        "name": "code",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/internal_gateway_transport_http.linkResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/internal_gateway_transport_http.errorResponse"
                        }
                    }
                }
            }
        },
        "/links/{code}/stats": {
            "get": {
                "description": "Returns the total click count and last-clicked time for a short code. Unknown codes report zero clicks rather than a 404 — Stat Service has no way to know whether a code is a real short link.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "stats"
                ],
                "summary": "Get click statistics",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Short code",
                        "name": "code",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/internal_gateway_transport_http.statsResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/internal_gateway_transport_http.errorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/internal_gateway_transport_http.errorResponse"
                        }
                    }
                }
            }
        },
        "/ready": {
            "get": {
                "description": "Unlike /health (pure liveness), this actively checks Core Service and Stat Service's own gRPC health endpoints.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "health"
                ],
                "summary": "Readiness check",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/internal_gateway_transport_http.readinessResponse"
                        }
                    },
                    "503": {
                        "description": "Service Unavailable",
                        "schema": {
                            "$ref": "#/definitions/internal_gateway_transport_http.readinessResponse"
                        }
                    }
                }
            }
        },
        "/{code}": {
            "get": {
                "description": "The hot path: resolves a short code and redirects the client. Also publishes a click event to RabbitMQ, asynchronously.",
                "tags": [
                    "links"
                ],
                "summary": "Redirect to the long URL",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Short code",
                        "name": "code",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "302": {
                        "description": "Found"
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/internal_gateway_transport_http.errorResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "internal_gateway_transport_http.createLinkRequest": {
            "type": "object",
            "required": [
                "url"
            ],
            "properties": {
                "url": {
                    "type": "string",
                    "example": "https://example.com/some/long/path"
                }
            }
        },
        "internal_gateway_transport_http.errorResponse": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string",
                    "example": "link: not found"
                }
            }
        },
        "internal_gateway_transport_http.linkResponse": {
            "type": "object",
            "properties": {
                "code": {
                    "type": "string",
                    "example": "abc1234"
                },
                "created_at": {
                    "type": "string"
                },
                "long_url": {
                    "type": "string",
                    "example": "https://example.com/some/long/path"
                },
                "short_url": {
                    "type": "string",
                    "example": "http://localhost:8080/abc1234"
                }
            }
        },
        "internal_gateway_transport_http.readinessResponse": {
            "type": "object",
            "properties": {
                "core": {
                    "type": "boolean"
                },
                "stat": {
                    "type": "boolean"
                }
            }
        },
        "internal_gateway_transport_http.statsResponse": {
            "type": "object",
            "properties": {
                "code": {
                    "type": "string",
                    "example": "abc1234"
                },
                "last_clicked_at": {
                    "type": "string"
                },
                "total_clicks": {
                    "type": "integer",
                    "example": 42
                }
            }
        }
    }
}